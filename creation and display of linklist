#include <iostream>
using namespace std;
struct Node
{
    int data;
    Node *next;
};
void display(Node *head)
{
    Node *temp = head;

    while(temp != NULL)
    {
        cout << temp->data << " -> ";
        temp = temp->next;
    }

    cout << "NULL";
}

int main()
{
    Node *first = new Node();
    Node *second = new Node();
    Node *third = new Node();

    first->data = 1;
    second->data = 2;
    third->data = 3;

    first->next = second;
    second->next = third;
    third->next = NULL;

    Node *head = first;
    display(head);

    return 0;
}
