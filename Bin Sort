#include <iostream>
using namespace std;

// Function to find the maximum element
int maximum(int a[], int n) {
    int maxElement = a[0];

    for (int i = 1; i < n; i++) {
        if (a[i] > maxElement) {
            maxElement = a[i];
        }
    }

    return maxElement;
}

// Bucket/Bin Sort
void binSort(int a[], int n) {
    int greatest = maximum(a, n);

    // Create bins
    int bins[100][100] = {0};
    int count[100] = {0};

    // Place elements into their respective bins
    for (int i = 0; i < n; i++) {
        bins[a[i]][count[a[i]]] = a[i];
        count[a[i]]++;
    }

    // Copy elements back to the original array
    int k = 0;

    for (int i = 0; i <= greatest; i++) {
        for (int j = 0; j < count[i]; j++) {
            a[k] = bins[i][j];
            k++;
        }
    }
}

int main() {
    int a[] = {5, 2, 8, 3, 1, 4, 2};
    int n = 7;

    binSort(a, n);

    cout << "Sorted array: ";

    for (int i = 0; i < n; i++) {
        cout << a[i] << " ";
    }

    return 0;
}
